+/// Offers the repository zip ez-github saved: download it, then hand it to the
+/// share sheet (Save to Files, AirDrop, ...). The link is short-lived.
+- (void)offerGitHubArchive:(NSDictionary *)archive {
+    NSString *urlString = [archive[@"url"] isKindOfClass:[NSString class]] ? archive[@"url"] : @"";
+    NSString *filename = [archive[@"filename"] isKindOfClass:[NSString class]] ? archive[@"filename"] : @"repository.zip";
+    NSURL *url = [NSURL URLWithString:urlString];
+    if (!url || ![url.scheme.lowercaseString isEqualToString:@"https"]) return;
+
+    NSString *safeName = filename.lastPathComponent;
+    if (safeName.length == 0 || [safeName hasPrefix:@"."]) safeName = @"repository.zip";
+    double megabytes = [archive[@"bytes"] respondsToSelector:@selector(doubleValue)]
+        ? [archive[@"bytes"] doubleValue] / 1000000.0 : 0;
+    NSString *sizeText = megabytes > 0 ? [NSString stringWithFormat:@" (%.1f MB)", megabytes] : @"";
+
+    UIAlertController *alert = [UIAlertController
+        alertControllerWithTitle:@"Repository zip ready"
+                         message:[NSString stringWithFormat:@"%@%@\nThe download link works for about an hour.", safeName, sizeText]
+                  preferredStyle:UIAlertControllerStyleAlert];
+    [alert addAction:[UIAlertAction actionWithTitle:@"Not now" style:UIAlertActionStyleCancel handler:nil]];
+    __weak typeof(self) weakSelf = self;
+    [alert addAction:[UIAlertAction actionWithTitle:@"Download" style:UIAlertActionStyleDefault
+                                            handler:^(UIAlertAction *action) {
+        __strong typeof(weakSelf) strongSelf = weakSelf;
+        if (!strongSelf) return;
+        [strongSelf appendToChat:@"[System: Downloading the repository zip…]"];
+        [[[NSURLSession sharedSession] downloadTaskWithURL:url
+            completionHandler:^(NSURL *location, NSURLResponse *response, NSError *downloadError) {
+            NSInteger status = [response isKindOfClass:[NSHTTPURLResponse class]]
+                ? ((NSHTTPURLResponse *)response).statusCode : 0;
+            NSURL *destination = nil;
+            if (!downloadError && location && status >= 200 && status < 300) {
+                destination = [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:safeName]];
+                NSFileManager *fm = [NSFileManager defaultManager];
+                [fm removeItemAtURL:destination error:nil];
+                if (![fm moveItemAtURL:location toURL:destination error:nil]) destination = nil;
+            }
+            dispatch_async(dispatch_get_main_queue(), ^{
+                __strong typeof(weakSelf) innerSelf = weakSelf;
+                if (!innerSelf) return;
+                if (!destination) {
+                    [innerSelf appendToChat:@"[System: Couldn't download the zip. The link may have expired; ask again to get a new one.]"];
+                    return;
+                }
+                UIActivityViewController *share = [[UIActivityViewController alloc]
+                    initWithActivityItems:@[destination] applicationActivities:nil];
+                UIViewController *presenter = [innerSelf ez_githubPresenter];
+                share.popoverPresentationController.sourceView = presenter.view;
+                share.popoverPresentationController.sourceRect =
+                    CGRectMake(CGRectGetMidX(presenter.view.bounds), CGRectGetMidY(presenter.view.bounds), 1, 1);
+                [presenter presentViewController:share animated:YES completion:nil];
+            });
+        }] resume];
+    }]];
+    [[self ez_githubPresenter] presentViewController:alert animated:YES completion:nil];
+}
+
+/// Trims every GitHub result in the context down to its first few lines. Run
+/// once the model has answered: the answer carries what mattered, and keeping
+/// whole files in history would make every later turn slower and dearer.
+- (void)ez_compactGitHubResults {
+    for (NSUInteger i = 0; i < self.chatContext.count; i++) {
+        NSDictionary *entry = self.chatContext[i];
+        if (![entry[@"_githubResult"] boolValue] || [entry[@"_githubCompacted"] boolValue]) continue;
+        NSString *content = [entry[@"content"] isKindOfClass:[NSString class]] ? entry[@"content"] : @"";
+        NSMutableDictionary *trimmed = [entry mutableCopy];
+        trimmed[@"_githubCompacted"] = @YES;
+        if (content.length > kEZGitHubResultKeepChars) {
+            // Cut on a composed-character boundary so an emoji is never split
+            // (a lone surrogate makes NSJSONSerialization refuse the request).
+            NSRange safe = [content rangeOfComposedCharacterSequencesForRange:NSMakeRange(0, kEZGitHubResultKeepChars)];
+            trimmed[@"content"] = [NSString stringWithFormat:
+                @"%@\n[…%lu more characters of this GitHub result were dropped after it was used, to keep the conversation small. Call the github tool again if you need them.]\n[End of GitHub tool result]",
+                [content substringWithRange:safe], (unsigned long)(content.length - safe.length)];
+        }
+        self.chatContext[i] = trimmed;
+    }
+}
