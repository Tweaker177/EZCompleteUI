+// ─────────────────────────────────────────────────────────────────────────────
+// MARK: - GitHub tool (github_request from ez-chat)
+// ─────────────────────────────────────────────────────────────────────────────
+//
+// Flow: ez-chat returns a github_request (already validated and clamped) plus
+// a one-line github_summary. -performChatGitHubRequest:summary:threadID: sends
+// it to the ez-github function, which is the only place that holds the user's
+// GitHub token.
+//   - A read comes straight back as message_for_model: a size-capped text block
+//     already framed as untrusted data. It is appended to chatContext as a user
+//     message stamped _githubResult (so it never becomes a chat bubble, and the
+//     "_" key is stripped before the API call), and the chat is sent again so
+//     the model can continue or answer.
+//   - A write comes back as a preview (needs_confirmation). Nothing changes on
+//     GitHub until the user approves it here; the same request is then re-sent
+//     with confirmed:YES. Declining is reported back to the model as a fact.
+//
+// Loop guard: at most kEZChatGitHubMaxRounds GitHub steps per user message
+// (githubRoundCount is reset by -callChatCompletions, the user-send entry
+// point). After the model's final answer lands, old results are trimmed
+// (-ez_compactGitHubResults) so later turns don't re-send whole files.
+
+static NSInteger const kEZChatGitHubMaxRounds = 8;
+/// Characters of each GitHub result kept in history after the model has used it.
+static NSUInteger const kEZGitHubResultKeepChars = 1500;
+static NSUInteger const kEZGitHubApprovalMaxChars = 1400;
+
+- (void)performChatGitHubRequest:(NSDictionary *)githubRequest
+                         summary:(NSString *)summary
+                        threadID:(NSString *)threadID {
+    if (self.githubRoundCount >= kEZChatGitHubMaxRounds) {
+        self.sendButton.enabled = YES;
+        [self appendToChat:[NSString stringWithFormat:
+            @"[System: Stopped after %ld GitHub steps for this message. Ask again to keep going.]",
+            (long)kEZChatGitHubMaxRounds]];
+        return;
+    }
+    self.githubRoundCount += 1;
+    self.sendButton.enabled = NO;
+    NSString *shown = summary.length > 0 ? summary : @"Running a GitHub action";
+    [self appendToChat:[NSString stringWithFormat:@"[System: 🐙 %@…]", shown]];
+    [self runChatGitHubRequest:githubRequest summary:shown confirmed:NO threadID:threadID];
+}
+
+- (void)runChatGitHubRequest:(NSDictionary *)request
+                     summary:(NSString *)summary
+                   confirmed:(BOOL)confirmed
+                    threadID:(NSString *)threadID {
+    __weak typeof(self) weakSelf = self;
+    [[EZGitHubService sharedService] runRequest:request
+                                      confirmed:confirmed
+                                     completion:^(NSDictionary *result, NSError *error) {
+        __strong typeof(weakSelf) strongSelf = weakSelf;
+        if (!strongSelf) return;
+        [strongSelf handleChatGitHubResult:result error:error request:request
+                                   summary:summary confirmed:confirmed threadID:threadID];
+    }];
+}
+
+/// The view controller to present alerts and sheets from, even if another
+/// screen is already on top of the chat.
+- (UIViewController *)ez_githubPresenter {
+    UIViewController *presenter = self;
+    while (presenter.presentedViewController && !presenter.presentedViewController.isBeingDismissed) {
+        presenter = presenter.presentedViewController;
+    }
+    return presenter;
+}
