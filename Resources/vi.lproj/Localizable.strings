"EZTutorial.Detail.Title" = "Chi tiết ảnh"; "EZTutorial.Detail.Body" = "Đặt câu hỏi sẽ đưa ảnh này trở lại cuộc trò chuyện. Mô tả chỉnh sửa bên dưới hoặc dùng + để thêm tối đa bốn ảnh tham chiếu và kết hợp thành một tác phẩm mới."; "EZTutorial.Detail.Prompt" = "Mô tả chỉnh sửa của bạn…"; "EZTutorial.Detail.Ask" = "Đặt câu hỏi"; "EZTutorial.Detail.Edit" = "Chỉnh sửa bằng AI";
"EZTutorial.Tools.Title" = "Ký ức và xu"; "EZTutorial.Tools.Body" = "Ký ức lưu các kết quả hữu ích. Cửa hàng xu quản lý gói và xu. Số dư luôn có sẵn từ màn hình chính.";
"EZTutorial.Memories.Title" = "Ký ức"; "EZTutorial.Memories.Body" = "Tìm kiếm các ký ức đã lưu, rồi chạm vào văn bản để chỉnh sửa. Chạm lại để đóng chỉnh sửa. Liên kết màu xanh mở đúng lượt trò chuyện nơi ký ức được tạo, và ảnh đính kèm mở Chi tiết ảnh."; "EZTutorial.Memories.Search" = "Tìm kiếm ký ức"; "EZTutorial.Memories.Source" = "Mở lượt trò chuyện gốc"; "EZTutorial.Memories.Editable" = "Chạm vào ký ức này để chỉnh sửa.";
"EZTutorial.CoinStore.Title" = "Cửa hàng xu"; "EZTutorial.CoinStore.Body" = "Nhật ký sử dụng ở góc trên bên phải liệt kê mọi khoản cộng và trừ. Nhận xu miễn phí bốn lần mỗi ngày và cho phép thông báo để được nhắc nhở. Một số mẫu và tính năng cao cấp cần mua để mở khóa. Gói đăng ký PayPal được cộng tự động và có các gói nạp một lần."; "EZTutorial.CoinStore.Usage" = "Nhật ký sử dụng"; "EZTutorial.CoinStore.Free" = "Xu miễn phí bốn lần mỗi ngày • Bật nhắc nhở"; "EZTutorial.CoinStore.Offer" = "MUA 1, TẶNG 1"; "EZTutorial.CoinStore.Select" = "Sẵn sàng bắt đầu? Chọn cấp độ phù hợp với nhu cầu của bạn.";
"EZTutorial.CoinStore.Bonus" = "Người đăng ký: 20 xu mỗi lần nhận • Không có gói: 10";
