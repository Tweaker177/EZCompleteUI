+static NSArray<UIColor *> *GMLineColors(void) {
+    return @[GMC(0xFFD60A), GMC(0x30D158), GMC(0x64D2FF), GMC(0xFF453A), GMC(0xBF5AF2), GMC(0xFF9F0A), GMC(0x5E5CE6), GMC(0xFF375F), GMC(0xA7F432)];
+}
